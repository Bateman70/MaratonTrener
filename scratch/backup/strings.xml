    <string name="description_easy_run">Light and relaxed pace to promote recovery and aerobic endurance. Should feel easy and allow for conversation.</string>
    <string name="description_long_run">Steady effort to build endurance. Early in the plan, keep it at a conversational pace. Later, aim for race pace.</string>
    <string name="description_tempo_run">Steady pace slightly outside comfort zone to improve lactate threshold. Push yourself, but keep it sustainable.</string>
    <string name="description_intervals">Interval training</string>
    <string name="choose">Choose</string>
    <string name="plan_generation_failed">Plan generation failed</string>
    <string name="desc_taper">Taper: Endurance at %s min/km. Saving energy for race day.</string>
    <string name="desc_endurance">Endurance: Target %s min/km. Time on feet is key.</string>
    <string name="desc_speedwork">Speedwork: %1$d sets at %2$s pace. Recovery: 90s jog.</string>
    <string name="desc_threshold">Threshold: Target %s min/km. Builds sustained speed.</string>
    <string name="desc_strength">Strength: Glute Bridges (3x15), Plank (3x60s), Single-Leg Squats (3x10). Injury prevention.</string>
    <string name="desc_strength_phase1">Strength Phase 1 (Foundation): Glute Bridges (3x15), Squats (3x15), Plank (3x60s), Supermans (3x12), Bird-Dogs (3x12), Push-ups (3x10), Walking Lunges (3x10/leg). Focus on posture and form.</string>
    <string name="desc_strength_phase2">Strength Phase 2 (Strength &amp; Back Focus): Dumbbell Rows (3x10/arm), Single-Leg Deadlifts (3x10/leg), Tricep Dips (3x12), Step-ups (3x12/leg), Side Plank (3x30s/side), Leg Raises (3x12). Target back fatigue.</string>
    <string name="desc_strength_phase3">Strength Phase 3 (Peak Power &amp; Posture): Dumbbell Rows (3x12/arm), Supermans (3x15), Single-Leg Glute Bridges (3x10/leg), Plank w/ Shoulder Taps (3x45s), Lunges w/ Twist (3x10/leg), Single-Leg Deadlifts (3x12/leg). Shock absorption for asphalt.</string>
    <string name="desc_easy">Easy Run: Target %s min/km. Keep heart rate low.</string>
