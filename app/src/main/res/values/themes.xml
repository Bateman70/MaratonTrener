<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Maratontrener" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/carbon_dark</item>
        <item name="colorPrimaryVariant">#000000</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/electric_lime</item>
        <item name="colorSecondaryVariant">@color/electric_lime</item>
        <item name="colorOnSecondary">@color/carbon_dark</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@drawable/app_background</item>
        <item name="android:windowTranslucentStatus">true</item>

        <!-- Button styles -->
        <item name="materialButtonStyle">@style/Widget.App.Button</item>

        <!-- DatePicker/TimePicker styles -->
        <item name="android:datePickerDialogTheme">@style/CustomDatePickerDialogTheme</item>
    </style>

    <style name="CustomDatePickerDialogTheme" parent="Theme.MaterialComponents.DayNight.Dialog">
        <item name="colorAccent">@color/electric_lime</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:windowBackground">@color/carbon_dark</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/PickerButtonStyle</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/PickerButtonStyle</item>
    </style>

    <style name="PickerButtonStyle" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/electric_lime</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.App.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/electric_lime</item>
        <item name="android:textColor">@color/carbon_dark</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CircleImage" parent="">
        <item name="cornerSize">50%</item>
    </style>

    <!-- Outlined TextInputLayout Style -->
    <style name="App.TextInputLayout.OutlinedBox" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="hintTextColor">@color/electric_lime</item>
        <item name="android:textColorHint">@color/text_input_hint_color</item>
        <item name="boxStrokeColor">@color/text_input_stroke_color</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="android:textColor">@color/white</item>
    </style>
</resources>
