<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/carbon_black"
    android:fitsSystemWindows="true">

    <!-- Parallax Background Image -->
    <!-- We set width to wrap_content and height to match_parent to keep aspect ratio
         Scaling and translation will be handled in Java code -->
    <ImageView
        android:id="@+id/parallaxBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/marathon_bg_new"
        android:scaleType="matrix"
        android:contentDescription="Scrolling Background" />

    <!-- Static Gradient Overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/background_gradient_overlay"
        android:clickable="false"
        android:focusable="false" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="56dp" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom"
        android:background="#AA000000"
        app:itemIconTint="@color/electric_lime"
        app:itemTextColor="@color/white"
        app:menu="@menu/bottom_nav_menu"
        app:labelVisibilityMode="unlabeled" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>